<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe avoids a console window on Windows; on Linux it builds a normal executable. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>qbert</AssemblyName>
    <!-- Lets single-file publish carry the native raylib library inside the executable. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Applies only to publish: cuts the self-contained executable from ~72 MB to ~14 MB. -->
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qbert.Core\Qbert.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

</Project>
